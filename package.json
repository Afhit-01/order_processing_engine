{
  "name": "order_processing_engine",
  "version": "1.0.0",
  "description": "Order processing API with order, return, and refund workflows",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "express",
    "typescript",
    "orders",
    "returns",
    "refunds"
  ],
  "author": "Fatihu Ayomide Abdulganiyu",
